{
  "dataset": "spider_balanced",
  "dataset_host": "local_folder",
  "local_folder_path": "data/prepared/spider/splits/balanced",
  "local_dataset_format": "manifest",
  "model": "facebook/dinov3-vits16-pretrain-lvd1689m",
  "model_backend": "dinov3_feature",
  "model_type": "vit",
  "learning_rate": 0.0001,
  "num_train_epochs": 10,
  "early_stopping_patience": 3,
  "batch_size": 32,
  "weight_decay": 0.01,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
  "num_labels": 2,
  "wandb": false,
  "push_to_hub": false,
  "output_dir": "nicme_spider_balanced_dinov3_vits_lora",
  "loss_function": "nicme_hybrid",
  "cost_matrix": [
    [0.0, 10.0],
    [1.0, 0.0]
  ],
  "class_names": ["black_widow", "false_widow"],
  "target_recall_class": "black_widow",
  "target_recall_floor": 0.95,
  "accuracy_floor": 0.8,
  "selection_accuracy_metric": "accuracy",
  "cs_lambda": 10.0,
  "cs_warmup_epochs": 5,
  "decision_modes": "argmax,calibrated_cost_min",
  "calibration_enabled": true,
  "peft_enabled": true,
  "peft_r": 8,
  "peft_alpha": 16,
  "peft_dropout": 0.1,
  "peft_target_modules": "query,value",
  "peft_modules_to_save": "classifier"
}
